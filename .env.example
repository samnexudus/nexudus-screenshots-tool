# Screenshot capture credentials (used by capture-docs-screenshots.mjs)
# Copy this file to .env and fill in the values. Never commit .env.

# Your Nexudus LLM key (sk-...) — authenticates the code-search mirror.
# If left blank, bootstrap falls back to the key configured for the
# nexudus-code-search MCP server in VS Code's mcp.json.
NEXUDUS_LLM_KEY=

# Shared dashboard login (used by targets: v3, v5, members).
PLAYWRIGHT_TEST_USERNAME=
PLAYWRIGHT_TEST_PASSWORD=

# Base URL override — optional. By default each target in targets.json uses
# its own baseUrl (dashboard.nexudus.com / flow.nexudus.com /
# kalkioflex.nexudus.site). Set to force one URL for every target.
#PLAYWRIGHT_TEST_BASE_URL=

# Contact account for the Members Portal (target: contact).
# Same portal URL as members, but a different account with different access.
CONTACT_USERNAME=
CONTACT_PASSWORD=
